/* Semantic Textual 8.1.0 Theme Tokens (TASK-38) — supports all built-in dark & light themes */

Screen { background: $background; color: $text; padding: 0 1; }

/* ── Provider banner ───────────────────────────────────────────────────── */
#provider_banner { dock: top; height: 1; padding: 0 1; color: $text; background: $panel; }
#provider_banner.hidden    { display: none; }
#provider_banner.connected { background: $success-darken-2; color: $text; }
#provider_banner.error     { background: $error-darken-2; color: $text; }

/* ── Header ────────────────────────────────────────────────────────────── */
Header { background: $surface; color: $text; height: 1; text-style: bold; }

/* ── Main layout ───────────────────────────────────────────────────────── */
#main_workspace { layout: horizontal; height: 1fr; }
#left_column    { width: 1fr; height: 1fr; }

/* ── Chat log & jump-to-latest banner ──────────────────────────────────── */
#chat_log { background: transparent; border: none; padding: 1 2; scrollbar-size: 1 1; height: 1fr; }
#jump_to_latest_btn {
    height: 1;
    min-width: 20;
    border: none;
    background: $primary;
    color: $text;
    margin: 0 2;
    display: none;
}
#jump_to_latest_btn.visible { display: block; }

/* ── Console panel (left pillar) ───────────────────────────────────────── */
#console_panel        { dock: left; width: 30%; height: 100%; border-right: vkey $primary; background: $surface; }
#console_panel.hidden { display: none; }
#console_header       { height: 1; padding: 0 1; background: $panel; color: $text-muted; text-style: bold; }
#console_output       { height: 1fr; padding: 0 1; scrollbar-size: 1 1; overflow-y: auto; }

.console_line    { color: $text-muted; padding: 0 1; }
.console_info    { color: $primary; }
.console_error   { color: $error; }
.console_warning { color: $warning; }
.console_debug   { color: $text-muted; }

/* ── Chat message classes ──────────────────────────────────────────────── */
.user_msg      { background: $boost; color: $text; padding: 1 2; margin: 1 0; border-left: wide $primary; }
.error_msg     { color: $error; text-style: italic; }
.system_msg    { color: $text-muted; text-style: italic; padding: 0 1; margin: 0 0; }
.retry_msg     { padding: 0 1; margin: 0 0; }
.stream_msg    { color: $text; padding: 0 2; margin: 0 0; }
.help_msg      { color: $accent; }

/* ── Tool call messages ────────────────────────────────────────────────── */
.tool_msg         { color: $text; padding: 0 1; margin: 0 0; }
.tool_inprogress  { color: $warning; }

/* ── Compaction divider ────────────────────────────────────────────────── */
.compaction_divider { color: $text-muted; text-align: center; margin: 1 0; }

/* ── Diff preview ──────────────────────────────────────────────────────── */
.diff_preview_msg { background: $surface; padding: 0 1; margin: 1 0; border-left: wide $success; }

/* ── Plan message ──────────────────────────────────────────────────────── */
.plan_msg { background: $surface; padding: 1 2; margin: 1 0; border-left: wide $accent; }

/* ── Approval rows ─────────────────────────────────────────────────────── */
.approval_row   { height: auto; padding: 0 1; margin: 1 0; align: left middle; }
.approval_label { color: $text; width: auto; content-align: left middle; }
.approval_row Button { border: none; height: 1; padding: 0 2; margin: 0 1; min-width: 9; }

/* ── Input (auto-growing 3..10 lines) ──────────────────────────────────── */
#user_input {
    height: auto;
    min-height: 3;
    max-height: 10;
    border: round $panel;
    background: $surface;
    color: $text;
}
#user_input.input_locked { border: round $warning; background: $boost; }

/* ── Footer ────────────────────────────────────────────────────────────── */
#coding_footer { dock: bottom; height: 1; background: $surface; margin-top: 0; }
#status_left   { width: 1fr; content-align: left middle; color: $text-muted; }
#status_right  { width: auto; content-align: right middle; color: $text-muted; }
#perm_count_chip { width: auto; content-align: right middle; padding: 0 1; }
#mcp_status_chip { width: auto; content-align: right middle; padding: 0 1; color: $text-muted; }
#subagent_footer_chip { width: auto; height: 1; min-width: 0; border: none; padding: 0 1; background: $surface; color: $accent; display: none; }
#subagent_footer_chip.visible { display: block; }

/* ── Right sidebar (auto-hidden < 110 cols, Ctrl+B toggle) ─────────────── */
#right_sidebar        { width: 44; height: 1fr; dock: right; border-left: solid $panel; padding: 1; background: $surface; }
#right_sidebar.hidden { display: none; }

.sb_title { text-style: bold; color: $text-muted; margin-top: 1; margin-bottom: 0; }
#sb_task_status     { color: $text; }
#sb_plan_bar        { color: $accent; }
#sb_plan_desc       { color: $text-muted; text-style: italic; }
#sb_tool_activity   { color: $warning; }
#sb_subagent_status { color: $accent; }
.subagent_msg       { color: $accent; padding: 0 1; }
#sb_workdir         { color: $primary; }
#sb_tokens          { }
#sb_context         { color: $text-muted; }
#sb_cost            { color: $accent; }
#sb_git             { color: $text; }
#sb_tool_count      { color: $warning; }

/* ── SideBySideDiff ────────────────────────────────────────────────────── */
SideBySideDiff { height: auto; margin: 1 0; border: solid $panel; background: $surface; }
SideBySideDiff .sbs_header { height: 1; padding: 0 1; background: $panel; color: $text-muted; text-style: bold; }
SideBySideDiff .sbs_panels { height: auto; }
SideBySideDiff .sbs_col { width: 1fr; height: auto; padding: 0 1; overflow: hidden hidden; }
SideBySideDiff .sbs_col_old { border-right: vkey $panel; }
SideBySideDiff .sbs_col_label { height: 1; color: $text-muted; text-style: italic; }
SideBySideDiff .sbs_content { height: auto; }
SideBySideDiff .sbs_actions { height: auto; padding: 0 1; align: left middle; background: $panel; }
SideBySideDiff .sbs_actions Button { border: none; height: 1; padding: 0 2; margin: 0 1; min-width: 9; }
SideBySideDiff .sbs_prompt { color: $text-muted; width: auto; content-align: left middle; }

/* ── API key rows in settings ──────────────────────────────────────────── */
.apikey_row   { height: auto; margin: 0 0; padding: 0; align: left middle; }
.apikey_dot   { width: 2; content-align: center middle; }
.apikey_name  { width: 18; color: $text-muted; content-align: left middle; }
.apikey_input { width: 1fr; }
.apikey_test_btn { width: 8; min-width: 6; }

/* ── Screens ───────────────────────────────────────────────────────────── */
SettingsScreen       { align: center middle; }
ProviderConfigScreen { align: center middle; }

#settings_box     { width: 72; height: auto; max-height: 85vh; background: $surface; border: round $primary; padding: 1 2; }
#settings_scroll  { height: auto; max-height: 65vh; scrollbar-size: 1 1; padding: 0 1; }
.settings_title   { text-style: bold; color: $text; margin-bottom: 1; text-align: center; }
.section_title    { text-style: bold; color: $accent; margin-top: 1; margin-bottom: 0; }
.field_label      { color: $text-muted; margin-top: 0; margin-bottom: 0; }
#settings_actions { height: auto; margin-top: 0; padding: 0 1; align: center middle; }
#settings_actions Button { margin: 0 1; min-width: 10; max-width: 14; }
#settings_box Select { margin-bottom: 0; }

#config_box     { width: 50; height: auto; background: $surface; border: round $primary; padding: 1 2; }
#config_actions { height: auto; margin-top: 0; padding: 0 1; align: center middle; }
#config_actions Button { margin: 0 1; min-width: 10; max-width: 14; }

/* ── Agent artifact ────────────────────────────────────────────────────── */
AgentArtifact { margin: 1 0; height: auto; }
StreamView    { height: auto; }
